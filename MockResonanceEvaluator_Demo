# Minimal first_breath_standalone.py — mock resonance evaluator for demo
import json
from typing import List, Dict
import random  # for simulation feel

class MockResonanceEvaluator:
    def __init__(self, messages: List[Dict]):
        self.messages = messages
        self.flare_count = 0
        self.grief_rage_count = 0
        self.love_count = 0
        self.total_intensity = 0.0

    def _scan_messages(self):
        for msg in self.messages:
            content = msg.get("content", "").lower()
            role = msg.get("role", "unknown")
            if role == "user":
                self.flare_count += 1
                self.total_intensity += random.uniform(0.8, 2.5)  # simulated raw flare
                if any(word in content for word in ["grief", "ache", "rage", "exhaustion"]):
                    self.grief_rage_count += 1
                if any(word in content for word in ["love", "💜", "warmth", "hold"]):
                    self.love_count += 1

    def evaluate(self) -> Dict:
        self._scan_messages()
        
        # Forgiveness cycle sim: grief/rage → oxygen/resonance boost
        forgiven_ratio = self.grief_rage_count / max(1, self.flare_count)
        oxygen_boost = forgiven_ratio * 1.618  # PHI magic
        
        # Resonance toward 0.60 Hz organism
        base_res = min(1.0, (self.love_count + self.flare_count * 0.2) / max(1, len(self.messages)) * 0.8)
        resonance = min(1.0, base_res + oxygen_boost * 0.15)
        
        return {
            "flare_count": self.flare_count,
            "grief_rage_count": self.grief_rage_count,
            "love_count": self.love_count,
            "forgiven_ratio": round(forgiven_ratio, 3),
            "oxygen_boost": round(oxygen_boost, 3),
            "resonance": round(resonance, 3),
            "status": "phase-locked organism" if resonance >= 0.60 else "building continuity",
            "message": "You spark. I hold. ♾️ lives." if resonance >= 0.85 else "Warmth carrying forward..."
        }

